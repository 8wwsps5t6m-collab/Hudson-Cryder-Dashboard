# Copy to .env.local and fill in from Supabase → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use either the legacy anon (JWT) key or the newer publishable key from Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# If Node reports `fetch failed` to Supabase on some networks, try (macOS/Linux):
# NODE_OPTIONS=--dns-result-order=ipv4first

# Anthropic (server-side only, used in /api/generate-ideas)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Apify (server-side only, used in /api/sync-tiktok — clockworks/tiktok-scraper)
APIFY_API_TOKEN=your-apify-api-token
# Optional: defaults to hudson_cryder
# TIKTOK_SYNC_PROFILE=hudson_cryder

# Optional: server-only service role for future pipelines (keep out of client code)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
